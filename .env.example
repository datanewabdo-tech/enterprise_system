# Server & Database Configuration
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://enterprise_user:enterprise_secure_password_2026@localhost:5432/enterprise_dashboard?schema=public

# Security & Authentication
JWT_SECRET=super_secure_enterprise_jwt_secret_key_2026
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=super_secure_refresh_secret_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
MAX_FILE_SIZE_MB=100

# Client Vite Configuration
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_ANALYTICS=true
